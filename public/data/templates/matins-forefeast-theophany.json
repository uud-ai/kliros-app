    { "section": "Ектения сугубая", "role": "Диакон", "text": "Поми́луй нас, Бо́же, по вели́цей ми́лости Твое́й, мо́лим Ти ся, услы́ши и поми́луй." },
    { "section": "Ектения сугубая", "role": "Лик", "text": "Го́споди, поми́луй. Го́споди, поми́луй. Го́споди, поми́луй." },
    { "section": "Ектения сугубая", "role": "Диакон", "text": "Еще́ мо́лимся о Вели́ком Господи́не и отце́ на́шем Святе́йшем Патриа́рхе (имярек), и о господи́не на́шем преосвяще́ннейшем митрополи́те (или архиепи́скопе, или епи́скопе) (имярек), и о всей во Христе́ бра́тии на́шей." },
    { "section": "Ектения сугубая", "role": "Лик", "text": "Го́споди, поми́луй. Го́споди, поми́луй. Го́споди, поми́луй." },
    { "section": "Ектения сугубая", "role": "Диакон", "text": "Еще́ мо́лимся о Богохрани́мей стране́ на́шей, власте́х и во́инстве ея́, да ти́хое и безмо́лвное житие́ поживе́м во вся́ком благоче́стии и чистоте́." },
    { "section": "Ектения сугубая", "role": "Лик", "text": "Го́споди, поми́луй. Го́споди, поми́луй. Го́споди, поми́луй." },
    { "section": "Ектения сугубая", "role": "Иерей", "text": "Я́ко ми́лостив и человеколю́бец Бог еси́, и Тебе́ сла́ву возсыла́ем, Отцу́, и Сы́ну, и Свято́му Ду́ху, ны́не и при́сно, и во ве́ки веко́в." },
    { "section": "Ектения сугубая", "role": "Лик", "text": "Ами́нь." },

    { "section": "Ектения просительная", "role": "Диакон", "text": "Испо́лним у́треннюю моли́тву на́шу Го́сподеви." },
    { "section": "Ектения просительная", "role": "Лик", "text": "Го́споди, поми́луй." },
    { "section": "Ектения просительная", "role": "Диакон", "text": "Заступи́, спаси́, поми́луй и сохрани́ нас, Бо́же, Твое́ю благода́тию." },
    { "section": "Ектения просительная", "role": "Лик", "text": "Го́споди, поми́луй." },
    { "section": "Ектения просительная", "role": "Диакон", "text": "Про́чее вре́мя живота́ на́шего в ми́ре и покая́нии сконча́ти у Го́спода про́сим." },
    { "section": "Ектения просительная", "role": "Лик", "text": "Пода́й, Го́споди." },
    { "section": "Ектения просительная", "role": "Диакон", "text": "Пресвяту́ю, пречи́стую, преблагослове́нную, сла́вную Влады́чицу на́шу Богоро́дицу и Присноде́ву Мари́ю, со все́ми святы́ми помяну́вше, са́ми себе́ и друг дру́га, и весь живо́т наш Христу́ Бо́гу предади́м." },
    { "section": "Ектения просительная", "role": "Лик", "text": "Тебе́, Го́споди." },
    { "section": "Ектения просительная", "role": "Иерей", "text": "Я́ко Бог ми́лости, щедро́т и человеколю́бия еси́, и Тебе́ сла́ву возсыла́ем, Отцу́, и Сы́ну, и Свято́му Ду́ху, ны́не и при́сно, и во ве́ки веко́в." },
    { "section": "Ектения просительная", "role": "Лик", "text": "Ами́нь." },

    { "section": "Завершение Утрени", "role": "Иерей", "text": "Мир всем." },
    { "section": "Завершение Утрени", "role": "Лик", "text": "И ду́хови твоему́." },
    { "section": "Завершение Утрени", "role": "Диакон", "text": "Главы́ на́ша Го́сподеви прикло́ним." },
    { "section": "Завершение Утрени", "role": "Лик", "text": "Тебе́, Го́споди." },
    { "section": "Завершение Утрени", "role": "Иерей", "text": "Сла́ва Тебе́, Христе́ Бо́же, упова́ние на́ше, сла́ва Тебе́." },
    { "section": "Завершение Утрени", "role": "Лик", "text": "Сла́ва, и ны́не: Го́споди поми́луй (Трижды), благослови́." },
    {
      "section": "Завершение Утрени",
      "role": "Иерей",
      "text": "{{minea.otpust}}",
      "variable_type": "minea",
      "variable_key": "otpust",
      "fallback": "Христо́с, и́стинный Бог наш, гряды́й крести́тися от Иоа́нна во Иорда́не нас ра́ди спасе́ния, моли́твами Пречи́стыя Своея́ Ма́тере и святы́м [и́мя святого], поми́лует и спасе́т нас, я́ко Благ и Человеколю́бец."
    },
    { "section": "Завершение Утрени", "role": "Лик", "text": "Ами́нь." }
  ]
